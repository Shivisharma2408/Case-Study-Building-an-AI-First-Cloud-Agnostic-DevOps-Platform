# Generated by aiops geniac for service 'notifications'. Regenerate rather than edit.
# Landing zone (namespace, quota, limits) via the shared, cloud-agnostic app module.
terraform {
  required_version = ">= 1.6.0"
  required_providers {
    kubernetes = { source = "hashicorp/kubernetes", version = "~> 2.35" }
  }
}

variable "kubeconfig_path" {
  type    = string
  default = "~/.kube/config"
}

variable "kube_context" {
  type    = string
  default = "kind-idea-board"
}

provider "kubernetes" {
  config_path    = pathexpand(var.kubeconfig_path)
  config_context = var.kube_context
}

module "landing_zone" {
  source    = "../../../infra/terraform/modules/app"
  namespace = "notifications"
  quota = {
    requests_cpu    = "50m"
    requests_memory = "128Mi"
    limits_cpu      = "400m"
    limits_memory   = "256Mi"
    pods            = 4
  }
}
