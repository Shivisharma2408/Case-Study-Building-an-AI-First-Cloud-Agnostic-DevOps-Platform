# Copy to .env (git-ignored) and adjust. Never commit real credentials.

# --- Database (docker-compose) ---
POSTGRES_DB=ideas
POSTGRES_USER=ideas
POSTGRES_PASSWORD=change-me-locally

# --- Backend ---
LOG_LEVEL=INFO
MAX_IDEA_LENGTH=500

# --- Published ports (docker-compose) ---
FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- AI (local, free) ---
# Set AI_ENABLED=false to force deterministic fallbacks.
AI_ENABLED=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
AI_TIMEOUT_SECONDS=90

# --- Local Kubernetes ---
KIND_CLUSTER_NAME=idea-board
INGRESS_HTTP_PORT=8080
